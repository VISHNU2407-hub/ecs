# Supabase configuration
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# SECURITY: Use only the publishable (anon) key here.
# Never use a secret key (sb_secret_*) in frontend code.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
